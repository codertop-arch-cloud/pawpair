# PawPair Environment Configuration
# When these Supabase variables are set, PawPair can connect to a live Supabase PostgreSQL database.
# When omitted, PawPair runs in full, persistent local demo mode with rich sample data.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
