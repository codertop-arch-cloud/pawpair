# =============================================================================
# Frontend Environment Variables — PawPair Client (Vite)
# =============================================================================
# Add these in Vercel: Project Settings → Environment Variables
# Use the VITE_ prefix; only these are exposed to the browser bundle.
#
# For LOCAL DEVELOPMENT:
#   Leave these unset (or copy this file to .env.local).
#   The Vite dev proxy (vite.config.ts) forwards /api/* to http://localhost:5001.
#
# For PRODUCTION (Vercel):
#   Set both variables in the Vercel dashboard for Production + Preview environments.
# =============================================================================

# Base URL for all REST API calls (no trailing slash)
VITE_API_BASE=https://pawpair-wgz8.onrender.com/api

# Base URL for the Socket.IO connection (no path, no trailing slash)
VITE_SOCKET_URL=https://pawpair-wgz8.onrender.com
